---
import Motes from '../components/Motes.astro';
import Vignette from '../components/Vignette.astro';
import RiverSpine from '../components/RiverSpine.astro';
import ProgressLine from '../components/ProgressLine.astro';
import Nav from '../components/Nav.astro';
import MompoxSubnav from '../components/MompoxSubnav.astro';
import BookCover from '../components/BookCover.astro';
import Footer from '../components/Footer.astro';
import Butterfly from '../components/Butterfly.astro';
import FloatingBookCta from '../components/FloatingBookCta.astro';
import JsonLd from '../components/JsonLd.astro';
import mainJs from '../scripts/main.js?raw';
import togglesJs from '../scripts/toggles.js?raw';
import globalCss from '../styles/global.css?raw';

// Site-wide constants
const SITE_URL = 'https://literatium-web.vercel.app';
const DEFAULT_OG_IMAGE = '/assets/literatium-logo-icon.jpeg';

const {
  title = 'Literatium — La Casa de las Historias · Mompox',
  description = 'Un refugio boutique en Mompox, donde la literatura, el café y el río Magdalena se confunden con el sueño. Hotel boutique · Libros & Café · UNESCO 1995.',
  titleEn,
  descriptionEn,
  showCover = false,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  jsonLd
} = Astro.props;

// Resolve canonical URL (page path → absolute URL)
const canonicalPath = canonical || Astro.url.pathname;
const canonicalUrl = SITE_URL + canonicalPath;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : SITE_URL + ogImage;

// Bilingual title/description — English versions only swap when present
const resolvedTitleEn = titleEn || title;
const resolvedDescriptionEn = descriptionEn || description;

// BreadcrumbList schema is auto-injected on every page from Astro.url.pathname
// (kept simple: Literatium > Page). Pages can pass richer jsonLd to extend.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: (() => {
    const path = canonicalPath.replace(/\/+$/, '') || '/';
    const parts = path.split('/').filter(Boolean);
    const items: any[] = [
      { '@type': 'ListItem', position: 1, name: 'Literatium', item: SITE_URL + '/' }
    ];
    let acc = '';
    parts.forEach((p, i) => {
      acc += '/' + p;
      // Pretty-print the segment name
      const pretty = decodeURIComponent(p)
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (c: string) => c.toUpperCase());
      items.push({
        '@type': 'ListItem',
        position: i + 2,
        name: pretty,
        item: SITE_URL + acc + (i === parts.length - 1 ? '' : '/')
      });
    });
    return items;
  })()
};

const allJsonLd: any[] = [breadcrumbSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) allJsonLd.push(...jsonLd);
  else allJsonLd.push(jsonLd);
}
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-en={resolvedTitleEn}>{title}</title>
<meta name="description" content={description} data-en={resolvedDescriptionEn}>
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" type="image/png" href="/assets/favicon-16.png" sizes="16x16">
<link rel="icon" type="image/png" href="/assets/favicon-180.png" sizes="180x180">
<link rel="icon" type="image/png" href="/assets/favicon-512.png" sizes="512x512">
<link rel="apple-touch-icon" href="/assets/favicon-180.png">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Literatium">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:locale" content="es_CO">
<meta property="og:locale:alternate" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>

<!-- Fonts: preconnect + preload stylesheet, display=swap already in URL -->
<script is:inline>document.documentElement.classList.add('js');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=IM+Fell+English+SC&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500;700&family=Cinzel:wght@500;600;700&family=Tangerine:wght@400;700&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=IM+Fell+English+SC&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500;700&family=Cinzel:wght@500;600;700&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">

<!-- Structured data -->
<JsonLd data={allJsonLd} />

<style is:inline set:html={globalCss} />
</head>
<body>
<Motes />
<Vignette />
<RiverSpine />
<ProgressLine />
<Nav />
<MompoxSubnav />
{showCover && <BookCover />}
<slot />
<Footer />
<Butterfly />
<FloatingBookCta />
<script is:inline set:html={mainJs} />
<script is:inline set:html={togglesJs} />
</body>
</html>
