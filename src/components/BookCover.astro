---
<div id="cover" role="button" tabindex="0" aria-label="Open the book">
  <div class="cover-face" id="cover-face">
    <div class="cover-front">
      <div class="cover-frame"><span class="cover-corner-tl"></span><span class="cover-corner-tr"></span><span class="cover-corner-bl"></span><span class="cover-corner-br"></span></div>
      <img class="cover-emblem" src="assets/literatium-logo-icon.jpeg" alt="Literatium emblem">
      <p class="cover-title" aria-hidden="true">Literatium</p>
      <div class="cover-fleuron">✦ ❦ ✦</div>
      <p class="cover-sub" data-en="The House of Stories">La Casa de las Historias</p>
      <p class="cover-sub" style="margin-top:6px; opacity:0.7; font-size:0.65rem;">Mompox · Bolívar · Colombia</p>
      <div class="cover-prompt" data-en="━ Touch to open the book ━">━ Toca para abrir el libro ━</div>
    </div>
    <div class="cover-back" aria-hidden="true"></div>
  </div>
</div>
