    <path d="M 40 0 Q 60 100, 30 200 T 50 400 Q 70 500, 35 600 T 55 800 Q 75 900, 40 1000 T 50 1200" stroke="url(#river-grad)" stroke-width="2.5" fill="none" stroke-linecap="round" filter="url(#river-turb)" stroke-dasharray="8 6"><animate attributeName="stroke-dashoffset" from="0" to="-28" dur="3s" repeatCount="indefinite"/></path>
  </svg>
