---
interface Props {
  id: string;
  folioNumber: string;
  folioNumberEn?: string;
  dark?: boolean;
  next?: string;
  class?: string;
}
const { id, folioNumber, folioNumberEn, dark = false, next, class: extraClass = '' } = Astro.props;

const cornerSvg = `<svg viewBox="0 0 28 28"><path d="M 0 14 Q 0 0, 14 0" fill="none" stroke="${dark ? '#DDB95E' : '#C9A04E'}" stroke-width="1.5"/><circle cx="0" cy="0" r="2" fill="#DDB95E"/></svg>`;
const curlOuter = dark ? '#DDB95E' : '#8B6520';
const curlInner = dark ? '#0F2419' : '#FCF8EE';
const curlStroke = dark ? '#DDB95E' : '#C9A04E';
---
<section id={id} class={`folio ${dark ? 'on-dark' : 'bg-parchment'} ${extraClass}`}>
  {!dark && <div class="folio-border"></div>}
  {dark && <div class="folio-border" style="border-color: var(--brass); outline-color: var(--brass-dark); opacity: 0.3;"></div>}
  <div class="folio-corner tl" set:html={cornerSvg} />
  <div class="folio-corner tr" set:html={cornerSvg} />
  <div class="folio-corner bl" set:html={cornerSvg} />
  <div class="folio-corner br" set:html={cornerSvg} />
  <div class="folio-number" style={dark ? 'color: var(--brass-light);' : ''} data-en={folioNumberEn}>{folioNumber}</div>
  {next && (
    <div class="page-curl" data-next={next} role="button" tabindex="0">
      <svg viewBox="0 0 90 90"><path d="M 90 0 L 90 90 L 0 90 Z" fill={curlOuter} opacity="0.85"/><path d="M 90 0 L 90 90 L 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0 Z" fill={curlInner}/><path d="M 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0" stroke={curlStroke} stroke-width="1" fill="none" opacity="0.7"/></svg>
      <span class="page-curl-label">turn →</span>
    </div>
  )}
  <div class="folio-inner">
    <slot />
  </div>
</section>
