---
import Layout from '../layouts/Layout.astro';
import Folio from '../components/Folio.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ACTIVITIES, LIT_BONUS, STEP_OPTIONS } from '../data/itinerary-activities';

// Serialize data for client-side JS
const activitiesJson = JSON.stringify(ACTIVITIES);
const bonusJson = JSON.stringify(LIT_BONUS);
const optionsJson = JSON.stringify(STEP_OPTIONS);
---
<Layout title="Itinerario — Literatium" description="Construye tu itinerario personalizado en Mompox. Cinco preguntas, un itinerario a tu medida, descargable como PDF." titleEn="Itinerary — Literatium" descriptionEn="Build your personalised Mompox itinerary. Five questions, a tailored plan, downloadable as PDF.">

<!-- Embedded data for client-side JS -->
<script type="application/json" id="itinerary-activities" set:html={activitiesJson} />
<script type="application/json" id="itinerary-bonus" set:html={bonusJson} />
<script type="application/json" id="itinerary-options" set:html={optionsJson} />

<!-- jsPDF for PDF download -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<Folio id="itinerario" folioNumber="Folio XIV · Itinerario" folioNumberEn="Folio XIV · Itinerary" dark={true}>
  <Breadcrumbs items={[{ label: 'Literatium', href: '/' }, { label: 'Itinerario' }]} />

  <!-- Intro header (visible on all steps except result) -->
  <div id="itinerary-header" class="reveal">
    <div class="eyebrow" style="color: var(--brass-light);" data-en="Build your story · Chapter by chapter">Construye tu historia · Capítulo a capítulo</div>
    <h1 class="chapter-title on-dark" data-en="Your personalised Mompox itinerary">Tu itinerario personalizado en Mompox</h1>
    <p style="font-family: var(--font-body); color: var(--parchment); opacity: 0.8; max-width: 560px; margin: 14px auto 0; text-align: center;" data-en="Five questions. A tailored itinerary. Download it as a PDF and take it with you.">Cinco preguntas. Un itinerario a tu medida. Descárgalo como PDF y llévalo contigo.</p>
    <div class="fleuron" style="color: var(--brass-light);">✦ ❦ ✦</div>
  </div>

  <!-- Progress bar (5 steps) -->
  <div id="itinerary-progress" class="reveal delay-1">
    <div class="progress-dot active" data-step="0"></div>
    <div class="progress-dot" data-step="1"></div>
    <div class="progress-dot" data-step="2"></div>
    <div class="progress-dot" data-step="3"></div>
    <div class="progress-dot" data-step="4"></div>
  </div>

  <!-- Step container — JS swaps content here -->
  <div id="itinerary-step-container" class="reveal delay-1">
    <!-- Step 1: Duration (rendered by JS) -->
  </div>

  <!-- Navigation buttons -->
  <div id="itinerary-nav" class="reveal delay-2">
    <button id="itinerary-prev" class="itinerary-btn itinerary-btn-ghost" data-en="← Back">← Atrás</button>
    <button id="itinerary-next" class="itinerary-btn itinerary-btn-primary" data-en="Continue →">Continuar →</button>
  </div>

  <!-- Result container (hidden until step 6) -->
  <div id="itinerary-result" style="display: none;"></div>

</Folio>

<style is:global>
  /* ITINERARY BUILDER — Rethemed for Literatium literary aesthetic */
  #itinerary-progress {
    display: flex; justify-content: center; gap: 8px; margin: 30px auto 40px;
  }
  #itinerary-progress .progress-dot {
    width: 32px; height: 3px; border-radius: 2px; background: rgba(221,185,94,0.2);
    transition: all 0.4s ease;
  }
  #itinerary-progress .progress-dot.active { background: var(--brass); width: 48px; }

  #itinerary-nav {
    display: flex; justify-content: space-between; align-items: center;
    max-width: 700px; margin: 30px auto 0;
  }
  #itinerary-nav.hidden { display: none; }
  .itinerary-btn {
    font-family: var(--font-caps); font-size: 0.62rem; letter-spacing: 0.22em;
    padding: 12px 24px; border-radius: 2px; cursor: pointer; transition: all 0.3s ease;
    border: none; text-decoration: none;
  }
  .itinerary-btn-ghost {
    background: transparent; color: var(--brass-light); border: 1px solid rgba(221,185,94,0.4);
  }
  .itinerary-btn-ghost:hover { border-color: var(--brass); background: rgba(221,185,94,0.1); }
  .itinerary-btn-primary {
    background: var(--brass); color: var(--forest-dark); font-weight: 600;
  }
  .itinerary-btn-primary:hover { background: var(--brass-light); }
  .itinerary-btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
  .itinerary-btn:disabled { opacity: 0.3; cursor: not-allowed; }

  /* Step option cards */
  .itinerary-step-title {
    font-family: var(--font-display); font-style: italic; font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--brass-light); text-align: center; margin-bottom: 30px; max-width: 700px;
    margin-left: auto; margin-right: auto;
  }
  .itinerary-options-grid {
    display: grid; gap: 16px; max-width: 800px; margin: 0 auto;
  }
  .itinerary-options-grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .itinerary-options-grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .itinerary-options-grid.cols-4 { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .itinerary-options-grid.cols-5 { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }

  .itinerary-option {
    background: rgba(247,240,220,0.05); border: 1px solid rgba(221,185,94,0.25);
    padding: 20px; cursor: pointer; transition: all 0.3s ease; text-align: center;
  }
  .itinerary-option:hover { border-color: var(--brass); background: rgba(247,240,220,0.08); }
  .itinerary-option.selected { border-color: var(--brass); background: rgba(221,185,94,0.12); }
  .itinerary-option-icon { font-size: 2rem; margin-bottom: 8px; line-height: 1; }
  .itinerary-option-label {
    font-family: var(--font-display); font-style: italic; font-size: 1.05rem;
    color: var(--brass-light); margin-bottom: 4px;
  }
  .itinerary-option-desc {
    font-family: var(--font-body); font-size: 0.82rem; color: var(--parchment);
    opacity: 0.7; line-height: 1.4;
  }

  /* Result day cards */
  .itinerary-day-card {
    background: rgba(247,240,220,0.05); border: 1px solid rgba(221,185,94,0.25);
    padding: 28px; margin-bottom: 24px; max-width: 700px; margin-left: auto; margin-right: auto;
  }
  .itinerary-day-header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .itinerary-day-num {
    font-family: var(--font-display); font-style: italic; font-size: 2.5rem;
    color: var(--brass); opacity: 0.4; line-height: 1;
  }
  .itinerary-day-label {
    font-family: var(--font-caps); font-size: 0.56rem; letter-spacing: 0.28em;
    color: var(--brass); opacity: 0.8;
  }
  .itinerary-day-title {
    font-family: var(--font-display); font-style: italic; font-size: 1.2rem;
    color: var(--brass-light);
  }
  .itinerary-slot { display: flex; gap: 14px; margin-bottom: 16px; }
  .itinerary-slot-icon {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%;
    background: rgba(15,36,25,0.5); display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
  }
  .itinerary-slot-time {
    font-family: var(--font-caps); font-size: 0.54rem; letter-spacing: 0.22em;
    color: var(--brass); opacity: 0.8; margin-bottom: 2px;
  }
  .itinerary-slot-title {
    font-family: var(--font-display); font-size: 0.98rem; color: var(--parchment);
  }
  .itinerary-slot-desc {
    font-family: var(--font-body); font-size: 0.85rem; color: var(--parchment);
    opacity: 0.7; line-height: 1.5; margin-top: 2px;
  }

  /* Literatium bonus section */
  .itinerary-bonus {
    background: rgba(15,36,25,0.6); border: 1px solid var(--brass); padding: 32px;
    max-width: 700px; margin: 40px auto 0; text-align: center;
  }
  .itinerary-bonus-title {
    font-family: var(--font-display); font-style: italic; font-size: 1.2rem;
    color: var(--brass-light); margin-bottom: 8px;
  }
  .itinerary-bonus-sub {
    font-family: var(--font-body); font-size: 0.82rem; color: var(--parchment);
    opacity: 0.6; margin-bottom: 20px;
  }
  .itinerary-bonus-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;
    text-align: left;
  }
  .itinerary-bonus-item {
    display: flex; gap: 10px; align-items: flex-start;
    background: rgba(247,240,220,0.05); padding: 12px;
  }
  .itinerary-bonus-icon { font-size: 1.2rem; flex-shrink: 0; }
  .itinerary-bonus-item-title {
    font-family: var(--font-display); font-style: italic; font-size: 0.88rem;
    color: var(--brass-light);
  }
  .itinerary-bonus-item-desc {
    font-family: var(--font-body); font-size: 0.76rem; color: var(--parchment);
    opacity: 0.6; line-height: 1.4; margin-top: 2px;
  }

  /* Result actions */
  .itinerary-actions {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;
    max-width: 700px; margin: 30px auto 0;
  }
  .itinerary-action-btn {
    font-family: var(--font-caps); font-size: 0.62rem; letter-spacing: 0.22em;
    padding: 12px 24px; border-radius: 2px; cursor: pointer; transition: all 0.3s ease;
    border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
  }
  .itinerary-action-brass { background: var(--brass); color: var(--forest-dark); font-weight: 600; }
  .itinerary-action-brass:hover { background: var(--brass-light); }
  .itinerary-action-wa { background: #25D366; color: white; }
  .itinerary-action-wa:hover { background: #1da851; }
  .itinerary-action-ghost {
    background: transparent; color: var(--brass-light); border: 1px solid rgba(221,185,94,0.4);
  }
  .itinerary-action-ghost:hover { border-color: var(--brass); background: rgba(221,185,94,0.1); }

  /* Social share */
  .itinerary-share {
    text-align: center; max-width: 700px; margin: 24px auto 0;
  }
  .itinerary-share-label {
    font-family: var(--font-body); font-size: 0.78rem; color: var(--parchment);
    opacity: 0.6; margin-bottom: 10px;
  }
  .itinerary-share-icons { display: flex; justify-content: center; gap: 10px; }
  .itinerary-share-icons a {
    width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; transition: transform 0.3s ease; text-decoration: none;
  }
  .itinerary-share-icons a:hover { transform: scale(1.1); }
  .itinerary-share-icons .wa { background: #25D366; }
  .itinerary-share-icons .fb { background: #1877F2; }
  .itinerary-share-icons .tw { background: #000; }
  .itinerary-share-icons .ig { background: linear-gradient(135deg, #E1306C, #F77737); }
  .itinerary-share-icons svg { width: 18px; height: 18px; fill: white; }

  /* Step transition animation */
  .itinerary-step-enter {
    animation: itinerary-fade-in 0.4s ease;
  }
  @keyframes itinerary-fade-in {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (max-width: 640px) {
    .itinerary-options-grid.cols-3,
    .itinerary-options-grid.cols-2,
    .itinerary-options-grid.cols-4,
    .itinerary-options-grid.cols-5 {
      grid-template-columns: 1fr 1fr;
    }
    .itinerary-day-header { flex-direction: column; align-items: flex-start; gap: 4px; }
    .itinerary-day-num { font-size: 2rem; }
  }
</style>

<script is:inline>
(function() {
  'use strict';

  // ====== STATE ======
  var step = 0; // 0=duration, 1=style, 2=interests, 3=travelers, 4=pace, 5=result
  var stepNames = ['duration', 'style', 'interests', 'travelers', 'pace', 'result'];
  var answers = {
    duration: null,
    style: null,
    interests: [],
    travelers: null,
    pace: null
  };

  // ====== DATA (from embedded JSON) ======
  var ACTIVITIES = JSON.parse(document.getElementById('itinerary-activities').textContent);
  var LIT_BONUS = JSON.parse(document.getElementById('itinerary-bonus').textContent);
  var OPTIONS = JSON.parse(document.getElementById('itinerary-options').textContent);

  // ====== LANG DETECTION ======
  function currentLang() {
    return document.documentElement.lang === 'en' ? 'en' : 'es';
  }

  // ====== DOM ELEMENTS ======
  var container = document.getElementById('itinerary-step-container');
  var navDiv = document.getElementById('itinerary-nav');
  var prevBtn = document.getElementById('itinerary-prev');
  var nextBtn = document.getElementById('itinerary-next');
  var headerDiv = document.getElementById('itinerary-header');
  var progressDiv = document.getElementById('itinerary-progress');
  var resultDiv = document.getElementById('itinerary-result');

  // ====== RENDER STEPS ======
  function renderStep() {
    if (step === 5) {
      // Result step
      headerDiv.style.display = 'none';
      progressDiv.style.display = 'none';
      navDiv.classList.add('hidden');
      container.style.display = 'none';
      resultDiv.style.display = 'block';
      renderResult();
      return;
    }

    headerDiv.style.display = 'block';
    progressDiv.style.display = 'flex';
    navDiv.classList.remove('hidden');
    container.style.display = 'block';
    resultDiv.style.display = 'none';

    // Update progress dots
    var dots = progressDiv.querySelectorAll('.progress-dot');
    dots.forEach(function(d, i) { d.classList.toggle('active', i <= step); });

    // Update nav buttons
    prevBtn.disabled = step === 0;
    nextBtn.disabled = step === 2 ? answers.interests.length === 0 : false;
    nextBtn.style.display = step === 2 ? 'inline-block' : 'inline-block';

    // Render step content
    container.innerHTML = '';
    var content = '';
    var lang = currentLang();

    if (step === 0) content = renderDurationStep(lang);
    else if (step === 1) content = renderStyleStep(lang);
    else if (step === 2) content = renderInterestsStep(lang);
    else if (step === 3) content = renderTravelersStep(lang);
    else if (step === 4) content = renderPaceStep(lang);

    container.innerHTML = content;
    container.className = 'reveal delay-1 itinerary-step-enter';

    // Attach event listeners to options
    attachOptionListeners();
  }

  function renderDurationStep(lang) {
    var title = lang === 'es' ? '¿Cuántos días en Mompox?' : 'How many days in Mompox?';
    var html = '<h2 class="itinerary-step-title">' + title + '</h2>';
    html += '<div class="itinerary-options-grid cols-3">';
    OPTIONS.duration.forEach(function(o) {
      var selected = answers.duration === o.val ? ' selected' : '';
      var label = lang === 'es' ? o.es : o.en;
      var desc = lang === 'es' ? o.descEs : o.descEn;
      html += '<div class="itinerary-option' + selected + '" data-step="duration" data-val="' + o.val + '">';
      html += '<div class="itinerary-option-icon">' + o.icon + '</div>';
      html += '<div class="itinerary-option-label">' + label + '</div>';
      html += '<div class="itinerary-option-desc">' + desc + '</div>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  function renderStyleStep(lang) {
    var title = lang === 'es' ? '¿Cuál es tu estilo de viaje?' : 'What\'s your travel style?';
    var html = '<h2 class="itinerary-step-title">' + title + '</h2>';
    html += '<div class="itinerary-options-grid cols-2">';
    OPTIONS.style.forEach(function(o) {
      var selected = answers.style === o.val ? ' selected' : '';
      var label = lang === 'es' ? o.es : o.en;
      var desc = lang === 'es' ? o.descEs : o.descEn;
      html += '<div class="itinerary-option' + selected + '" data-step="style" data-val="' + o.val + '">';
      html += '<div class="itinerary-option-icon">' + o.icon + '</div>';
      html += '<div class="itinerary-option-label">' + label + '</div>';
      html += '<div class="itinerary-option-desc">' + desc + '</div>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  function renderInterestsStep(lang) {
    var title = lang === 'es' ? '¿Qué te interesa? (Elige varios)' : 'What interests you? (Choose several)';
    var html = '<h2 class="itinerary-step-title">' + title + '</h2>';
    html += '<div class="itinerary-options-grid cols-5">';
    OPTIONS.interests.forEach(function(o) {
      var selected = answers.interests.indexOf(o.val) >= 0 ? ' selected' : '';
      var label = lang === 'es' ? o.es : o.en;
      html += '<div class="itinerary-option' + selected + '" data-step="interests" data-val="' + o.val + '">';
      html += '<div class="itinerary-option-icon">' + o.icon + '</div>';
      html += '<div class="itinerary-option-label">' + label + '</div>';
      html += '</div>';
    });
    html += '</div>';
    var countText = lang === 'es'
      ? answers.interests.length + ' seleccionado' + (answers.interests.length === 1 ? '' : 's')
      : answers.interests.length + ' selected';
    html += '<p style="text-align:center; font-family:var(--font-body); font-style:italic; font-size:0.82rem; color:var(--parchment); opacity:0.6; margin-top:16px;">' + countText + '</p>';
    return html;
  }

  function renderTravelersStep(lang) {
    var title = lang === 'es' ? '¿Con quién viajas?' : 'Who are you travelling with?';
    var html = '<h2 class="itinerary-step-title">' + title + '</h2>';
    html += '<div class="itinerary-options-grid cols-4">';
    OPTIONS.travelers.forEach(function(o) {
      var selected = answers.travelers === o.val ? ' selected' : '';
      var label = lang === 'es' ? o.es : o.en;
      html += '<div class="itinerary-option' + selected + '" data-step="travelers" data-val="' + o.val + '">';
      html += '<div class="itinerary-option-icon">' + o.icon + '</div>';
      html += '<div class="itinerary-option-label">' + label + '</div>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  function renderPaceStep(lang) {
    var title = lang === 'es' ? '¿Qué ritmo prefieres?' : 'What pace do you prefer?';
    var html = '<h2 class="itinerary-step-title">' + title + '</h2>';
    html += '<div class="itinerary-options-grid cols-3">';
    OPTIONS.pace.forEach(function(o) {
      var selected = answers.pace === o.val ? ' selected' : '';
      var label = lang === 'es' ? o.es : o.en;
      var desc = lang === 'es' ? o.descEs : o.descEn;
      html += '<div class="itinerary-option' + selected + '" data-step="pace" data-val="' + o.val + '">';
      html += '<div class="itinerary-option-icon">' + o.icon + '</div>';
      html += '<div class="itinerary-option-label">' + label + '</div>';
      html += '<div class="itinerary-option-desc">' + desc + '</div>';
      html += '</div>';
    });
    html += '</div>';
    return html;
  }

  function attachOptionListeners() {
    var options = container.querySelectorAll('.itinerary-option');
    options.forEach(function(opt) {
      opt.addEventListener('click', function() {
        var stepName = opt.getAttribute('data-step');
        var val = opt.getAttribute('data-val');

        if (stepName === 'interests') {
          // Multi-select toggle
          var idx = answers.interests.indexOf(val);
          if (idx >= 0) answers.interests.splice(idx, 1);
          else answers.interests.push(val);
          // Update UI
          opt.classList.toggle('selected');
          nextBtn.disabled = answers.interests.length === 0;
        } else {
          // Single-select
          answers[stepName] = val;
          // Deselect siblings
          container.querySelectorAll('.itinerary-option').forEach(function(o) { o.classList.remove('selected'); });
          opt.classList.add('selected');
          // Auto-advance after 300ms (except interests)
          setTimeout(function() { if (step < 5) { step++; renderStep(); } }, 300);
        }
      });
    });
  }

  // ====== NAV BUTTONS ======
  prevBtn.addEventListener('click', function() {
    if (step > 0) { step--; renderStep(); }
  });
  nextBtn.addEventListener('click', function() {
    if (step < 5) { step++; renderStep(); }
  });

  // ====== BUILD ITINERARY LOGIC (ported from old repo) ======
  function buildItinerary(days, interests, pace, style) {
    var dayTitles = {
      es: ['El río y el primer capítulo', 'Las piedras y las manos', 'El silencio y las mariposas'],
      en: ['The river and the first chapter', 'The stones and the hands', 'The silence and the butterflies'],
    };

    // Filter activities by selected interests
    var candidateActivities = ACTIVITIES.filter(function(act) {
      return act.interests.some(function(i) { return interests.indexOf(i) >= 0; });
    });

    // Sort by style match
    candidateActivities.sort(function(a, b) {
      var aMatch = a.styles && a.styles.indexOf(style) >= 0 ? 0 : 1;
      var bMatch = b.styles && b.styles.indexOf(style) >= 0 ? 0 : 1;
      return aMatch - bMatch;
    });

    if (candidateActivities.length === 0) {
      candidateActivities = ACTIVITIES.slice(0, 6);
    }

    // Group by time slot
    var byTime = {
      morning: candidateActivities.filter(function(a) { return a.time === 'morning'; }),
      afternoon: candidateActivities.filter(function(a) { return a.time === 'afternoon'; }),
      evening: candidateActivities.filter(function(a) { return a.time === 'evening'; }),
    };

    var perDay = pace === 'packed' ? 3 : pace === 'balanced' ? 2 : 1;
    var usedIds = {};
    var itinerary = [];

    function pickActivity(time) {
      var pool = byTime[time].filter(function(a) { return !usedIds[a.id]; });
      if (pool.length === 0) return null;
      var pick = pool[0];
      usedIds[pick.id] = true;
      return pick;
    }

    for (var d = 0; d < days; d++) {
      var slots = [];
      var timeSlots;
      if (pace === 'slow') {
        timeSlots = [d % 3 === 0 ? 'morning' : d % 3 === 1 ? 'afternoon' : 'evening'];
      } else if (pace === 'balanced') {
        timeSlots = ['morning', 'afternoon'];
      } else {
        timeSlots = ['morning', 'afternoon', 'evening'];
      }

      for (var t = 0; t < timeSlots.length; t++) {
        var time = timeSlots[t];
        var act = pickActivity(time);
        if (act) {
          slots.push({ time: time, activity: act });
        } else {
          // Try other time slots
          var altTimes = ['morning', 'afternoon', 'evening'];
          for (var at = 0; at < altTimes.length; at++) {
            if (altTimes[at] === time) continue;
            var alt = pickActivity(altTimes[at]);
            if (alt) {
              slots.push({ time: altTimes[at], activity: alt });
              break;
            }
          }
        }
      }

      if (slots.length === 0) {
        var fallback = ACTIVITIES[d % ACTIVITIES.length];
        if (!usedIds[fallback.id]) {
          usedIds[fallback.id] = true;
          slots.push({ time: fallback.time, activity: fallback });
        }
      }

      itinerary.push({
        title: { es: dayTitles.es[d] || dayTitles.es[2], en: dayTitles.en[d] || dayTitles.en[2] },
        slots: slots,
      });
    }

    return itinerary;
  }

  // ====== RENDER RESULT ======
  function renderResult() {
    var lang = currentLang();
    var days = answers.duration || 2;
    var interests = answers.interests.length > 0 ? answers.interests : ['river', 'food', 'gabo'];
    var pace = answers.pace || 'balanced';
    var style = answers.style || 'cultural';

    var itinerary = buildItinerary(days, interests, pace, style);
    var html = '';

    // Result header
    html += '<div style="text-align: center; margin-bottom: 40px;">';
    html += '<div style="font-size: 2rem; margin-bottom: 10px;">✦</div>';
    html += '<h1 class="chapter-title on-dark" style="font-family: var(--font-hand);" data-en="Your story in Mompox">Tu historia en Mompox</h1>';
    html += '<p style="font-family: var(--font-hand); font-size: 1.3rem; color: var(--brass); font-style: italic; margin-top: 10px;">';
    html += days + ' ' + (lang === 'es' ? (days === 1 ? 'día' : 'días') : (days === 1 ? 'day' : 'days')) + ' · ' + interests.length + ' ' + (lang === 'es' ? 'intereses' : 'interests');
    html += '</p>';
    html += '<div class="fleuron" style="color: var(--brass-light);">✦ ❦ ✦</div>';
    html += '</div>';

    // Day cards
    var romans = ['I', 'II', 'III'];
    itinerary.forEach(function(day, dIdx) {
      html += '<div class="itinerary-day-card">';
      html += '<div class="itinerary-day-header">';
      html += '<span class="itinerary-day-num">' + (romans[dIdx] || (dIdx + 1)) + '</span>';
      html += '<div>';
      html += '<div class="itinerary-day-label">' + (lang === 'es' ? 'Día ' : 'Day ') + (dIdx + 1) + '</div>';
      html += '<div class="itinerary-day-title">' + (lang === 'es' ? day.title.es : day.title.en) + '</div>';
      html += '</div></div>';

      day.slots.forEach(function(slot) {
        var timeLabel = slot.time === 'morning' ? (lang === 'es' ? 'Mañana' : 'Morning')
                      : slot.time === 'afternoon' ? (lang === 'es' ? 'Tarde' : 'Afternoon')
                      : (lang === 'es' ? 'Noche' : 'Evening');
        var icon = slot.time === 'morning' ? '☀️' : slot.time === 'afternoon' ? '☕' : '🌙';
        var actTitle = lang === 'es' ? slot.activity.es.title : slot.activity.en.title;
        var actDesc = lang === 'es' ? slot.activity.es.desc : slot.activity.en.desc;

        html += '<div class="itinerary-slot">';
        html += '<div class="itinerary-slot-icon">' + icon + '</div>';
        html += '<div>';
        html += '<div class="itinerary-slot-time">' + timeLabel + '</div>';
        html += '<div class="itinerary-slot-title">' + actTitle + '</div>';
        html += '<div class="itinerary-slot-desc">' + actDesc + '</div>';
        html += '</div></div>';
      });

      html += '</div>';
    });

    // Literatium bonus
    html += '<div class="itinerary-bonus">';
    html += '<h3 class="itinerary-bonus-title">' + (lang === 'es' ? 'Bonus para huéspedes de Literatium' : 'Bonus for Literatium guests') + '</h3>';
    html += '<p class="itinerary-bonus-sub">' + (lang === 'es' ? 'Incluidas en tu estancia — sin coste adicional' : 'Included in your stay — at no extra cost') + '</p>';
    html += '<div class="itinerary-bonus-grid">';
    LIT_BONUS.forEach(function(b) {
      html += '<div class="itinerary-bonus-item">';
      html += '<span class="itinerary-bonus-icon">' + b.icon + '</span>';
      html += '<div>';
      html += '<div class="itinerary-bonus-item-title">' + (lang === 'es' ? b.es.title : b.en.title) + '</div>';
      html += '<div class="itinerary-bonus-item-desc">' + (lang === 'es' ? b.es.desc : b.en.desc) + '</div>';
      html += '</div></div>';
    });
    html += '</div></div>';

    // Action buttons
    html += '<div class="itinerary-actions">';
    html += '<button class="itinerary-action-btn itinerary-action-brass" id="itinerary-download">';
    html += '⬇ ' + (lang === 'es' ? 'Descargar itinerario PDF' : 'Download itinerary PDF');
    html += '</button>';
    html += '<a href="https://wa.me/573155382112" target="_blank" rel="noopener" class="itinerary-action-btn itinerary-action-wa">';
    html += '💬 ' + (lang === 'es' ? 'Reservar por WhatsApp' : 'Book via WhatsApp');
    html += '</a>';
    html += '<button class="itinerary-action-btn itinerary-action-ghost" id="itinerary-reset">';
    html += '↻ ' + (lang === 'es' ? 'Empezar de nuevo' : 'Start over');
    html += '</button>';
    html += '</div>';

    // Social share
    html += '<div class="itinerary-share">';
    html += '<p class="itinerary-share-label">' + (lang === 'es' ? 'Comparte tu itinerario' : 'Share your itinerary') + '</p>';
    html += '<div class="itinerary-share-icons">';
    var shareText = encodeURIComponent(lang === 'es' ? 'Mi itinerario en Mompox con Literatium' : 'My Mompox itinerary with Literatium');
    var shareUrl = encodeURIComponent('https://literatium-web.vercel.app/itinerario');
    html += '<a class="wa" href="https://wa.me/?text=' + shareText + '" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.07-1.38C8.42 21.5 10.15 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm5.3 14.1c-.22.62-1.28 1.18-1.78 1.26-.45.07-1.03.1-1.66-.11-.38-.12-.87-.28-1.5-.55-2.64-1.14-4.36-3.8-4.5-3.98-.14-.18-1.07-1.42-1.07-2.72 0-1.3.68-1.94.92-2.2.24-.27.53-.34.7-.34.18 0 .35 0 .5.01.16.01.38-.06.59.45.22.53.75 1.83.82 1.96.07.14.11.3.02.48-.09.18-.14.3-.27.45-.14.16-.29.35-.41.47-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.16-.18.69-.8.87-1.08.18-.27.36-.22.6-.13.24.09 1.54.73 1.8.86.27.14.44.2.5.31.07.11.07.63-.15 1.25z"/></svg></a>';
    html += '<a class="fb" href="https://www.facebook.com/sharer/sharer.php?u=' + shareUrl + '" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm3 6h-1.5c-.5 0-1 .5-1 1v1H15l-.5 2h-2v6h-2v-6H9V9h1.5V8c0-1.5 1-3 3-3h1.5v3z"/></svg></a>';
    html += '<a class="tw" href="https://twitter.com/intent/tweet?text=' + shareText + '&url=' + shareUrl + '" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>';
    html += '<a class="ig" href="https://www.instagram.com/literatium/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.66 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63 19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84c-3.4 0-6.16 2.76-6.16 6.16s2.76 6.16 6.16 6.16 6.16-2.76 6.16-6.16S15.4 5.84 12 5.84zm0 10.16c-2.2 0-4-1.8-4-4s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4zm6.4-10.4c-.8 0-1.44.64-1.44 1.44s.64 1.44 1.44 1.44 1.44-.64 1.44-1.44-.64-1.44-1.44-1.44z"/></svg></a>';
    html += '</div></div>';

    resultDiv.innerHTML = html;

    // Attach result button listeners
    document.getElementById('itinerary-download').addEventListener('click', function() {
      generatePDF(answers, itinerary, lang);
    });
    document.getElementById('itinerary-reset').addEventListener('click', function() {
      answers = { duration: null, style: null, interests: [], travelers: null, pace: null };
      step = 0;
      renderStep();
    });
  }

  // ====== PDF GENERATION (ported from old repo) ======
  function generatePDF(answers, itinerary, lang) {
    if (typeof window.jspdf === 'undefined') {
      alert(lang === 'es' ? 'El generador de PDF está cargando. Intenta de nuevo en un momento.' : 'PDF generator is loading. Try again in a moment.');
      return;
    }
    var doc = new window.jspdf.jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    var pageW = 210, pageH = 297, margin = 20, y = 0;

    // COVER PAGE
    doc.setFillColor(26, 58, 46); doc.rect(0, 0, pageW, pageH, 'F');
    doc.setDrawColor(184, 134, 47); doc.setLineWidth(0.8);
    doc.rect(margin - 4, margin - 4, pageW - 2 * (margin - 4), pageH - 2 * (margin - 4));
    doc.setLineWidth(0.3); doc.rect(margin, margin, pageW - 2 * margin, pageH - 2 * margin);
    doc.setTextColor(229, 200, 112); doc.setFont('times', 'italic'); doc.setFontSize(36);
    doc.text('Literatium', pageW / 2, 80, { align: 'center' });
    doc.setFontSize(11); doc.setFont('times', 'normal');
    doc.text(lang === 'es' ? 'La Casa de las Historias' : 'The House of Stories', pageW / 2, 90, { align: 'center' });
    doc.setDrawColor(184, 134, 47); doc.setLineWidth(0.5);
    doc.line(pageW / 2 - 30, 100, pageW / 2 - 5, 100); doc.line(pageW / 2 + 5, 100, pageW / 2 + 30, 100);
    doc.setFontSize(10); doc.text('✦', pageW / 2, 101, { align: 'center' });
    doc.setFont('times', 'italic'); doc.setFontSize(24);
    doc.text(lang === 'es' ? 'Tu historia en Mompox' : 'Your story in Mompox', pageW / 2, 130, { align: 'center' });
    doc.setFontSize(12); doc.setFont('times', 'normal'); doc.setTextColor(245, 238, 220);
    var days = answers.duration || 2;
    doc.text(lang === 'es' ? days + ' ' + (days === 1 ? 'día' : 'días') + ' · ' + (answers.interests || []).length + ' intereses' : days + ' ' + (days === 1 ? 'day' : 'days') + ' · ' + (answers.interests || []).length + ' interests', pageW / 2, 145, { align: 'center' });
    doc.setFontSize(10); doc.setFont('times', 'italic'); doc.setTextColor(184, 134, 47);
    doc.text(lang === 'es' ? '«Mompox no existe, a veces soñamos con ella pero no existe.»' : '«Mompox doesn\'t exist; sometimes we dream of her, but she doesn\'t exist.»', pageW / 2, 180, { align: 'center' });
    doc.setFontSize(9); doc.text('— Gabriel García Márquez', pageW / 2, 187, { align: 'center' });
    doc.setFontSize(9); doc.setTextColor(229, 200, 112);
    doc.text('Calle 21 #2-47, Santa Cruz de Mompox, Bolívar', pageW / 2, pageH - 40, { align: 'center' });
    doc.text('+57 315 538 2112 · wa.me/573155382112', pageW / 2, pageH - 35, { align: 'center' });
    doc.setFont('times', 'italic'); doc.text('literatium-web.vercel.app', pageW / 2, pageH - 30, { align: 'center' });

    // DAY PAGES
    var romans = ['I', 'II', 'III'];
    itinerary.forEach(function(day, dIdx) {
      doc.addPage();
      doc.setFillColor(250, 244, 226); doc.rect(0, 0, pageW, pageH, 'F');
      y = margin + 5;
      doc.setFont('times', 'italic'); doc.setFontSize(42); doc.setTextColor(184, 134, 47, 100);
      doc.text(romans[dIdx] || '' + (dIdx + 1), margin, y + 8);
      doc.setFontSize(9); doc.setFont('times', 'normal'); doc.setTextColor(184, 134, 47);
      doc.text(lang === 'es' ? 'DÍA ' + (dIdx + 1) : 'DAY ' + (dIdx + 1), margin + 20, y);
      doc.setFontSize(18); doc.setFont('times', 'italic'); doc.setTextColor(26, 58, 46);
      doc.text(lang === 'es' ? day.title.es : day.title.en, margin + 20, y + 8);
      doc.setDrawColor(184, 134, 47); doc.setLineWidth(0.3);
      doc.line(margin, y + 15, pageW - margin, y + 15);
      y += 25;
      day.slots.forEach(function(slot) {
        var timeLabel = slot.time === 'morning' ? (lang === 'es' ? 'MAÑANA' : 'MORNING') : slot.time === 'afternoon' ? (lang === 'es' ? 'TARDE' : 'AFTERNOON') : (lang === 'es' ? 'NOCHE' : 'EVENING');
        var icon = slot.time === 'morning' ? '☀' : slot.time === 'afternoon' ? '☕' : '☾';
        doc.setFontSize(8); doc.setFont('times', 'normal'); doc.setTextColor(184, 134, 47);
        doc.text(icon + '  ' + timeLabel, margin, y); y += 6;
        doc.setFontSize(14); doc.setFont('times', 'italic'); doc.setTextColor(26, 58, 46);
        var title = lang === 'es' ? slot.activity.es.title : slot.activity.en.title;
        var titleLines = doc.splitTextToSize(title, pageW - 2 * margin - 10);
        doc.text(titleLines, margin + 5, y); y += titleLines.length * 6;
        doc.setFontSize(10); doc.setFont('times', 'normal'); doc.setTextColor(107, 81, 56);
        var desc = lang === 'es' ? slot.activity.es.desc : slot.activity.en.desc;
        var descLines = doc.splitTextToSize(desc, pageW - 2 * margin - 10);
        doc.text(descLines, margin + 5, y); y += descLines.length * 5 + 8;
        doc.setFontSize(8); doc.setTextColor(184, 134, 47, 60);
        doc.text('✦', pageW / 2, y); y += 8;
      });
      if (y < pageH - 50) {
        y += 5; doc.setDrawColor(184, 134, 47); doc.setLineWidth(0.2);
        doc.line(margin, y, pageW - margin, y); y += 7;
        doc.setFontSize(8); doc.setFont('times', 'normal'); doc.setTextColor(184, 134, 47);
        doc.text(lang === 'es' ? 'CONSEJO DE MARTICA' : 'MARTICA\'S TIP', margin, y); y += 5;
        doc.setFontSize(10); doc.setFont('times', 'italic'); doc.setTextColor(114, 47, 55);
        var tip = lang === 'es' ? 'Camina despacio. Mompox no se visita corriendo — se recorre como quien hojea un libro.' : 'Walk slowly. Mompox is not visited running — it is leafed through like a book.';
        var tipLines = doc.splitTextToSize(tip, pageW - 2 * margin - 5);
        doc.text(tipLines, margin, y);
      }
    });

    // BONUS PAGE
    doc.addPage();
    doc.setFillColor(26, 58, 46); doc.rect(0, 0, pageW, pageH, 'F');
    y = 40;
    doc.setFont('times', 'italic'); doc.setFontSize(22); doc.setTextColor(229, 200, 112);
    doc.text(lang === 'es' ? 'Bonus para huéspedes' : 'Guest bonus', pageW / 2, y, { align: 'center' });
    y += 5; doc.setDrawColor(184, 134, 47); doc.setLineWidth(0.3);
    doc.line(pageW / 2 - 25, y, pageW / 2 + 25, y); y += 15;
    doc.setFontSize(10); doc.setFont('times', 'italic'); doc.setTextColor(245, 238, 220);
    doc.text(lang === 'es' ? 'Incluidas en tu estancia — sin coste adicional' : 'Included in your stay — at no extra cost', pageW / 2, y, { align: 'center' }); y += 15;
    LIT_BONUS.forEach(function(b) {
      doc.setFontSize(12); doc.setFont('times', 'italic'); doc.setTextColor(229, 200, 112);
      doc.text(b.icon + '  ' + (lang === 'es' ? b.es.title : b.en.title), pageW / 2, y, { align: 'center' }); y += 6;
      doc.setFontSize(9); doc.setFont('times', 'normal'); doc.setTextColor(245, 238, 220, 200);
      var desc = lang === 'es' ? b.es.desc : b.en.desc;
      var descLines = doc.splitTextToSize(desc, pageW - 2 * margin - 20);
      doc.text(descLines, pageW / 2, y, { align: 'center' }); y += descLines.length * 5 + 10;
    });
    y = pageH - 50;
    doc.setFontSize(10); doc.setFont('times', 'italic'); doc.setTextColor(229, 200, 112);
    doc.text(lang === 'es' ? 'Tu historia comienza en Literatium.' : 'Your story begins at Literatium.', pageW / 2, y, { align: 'center' });
    y += 8; doc.setFontSize(9); doc.setFont('times', 'normal');
    doc.text('wa.me/573155382112', pageW / 2, y, { align: 'center' });

    doc.save(lang === 'es' ? 'Literatium-Tu-Itinerario-Mompox.pdf' : 'Literatium-Your-Mompox-Itinerary.pdf');
  }

  // ====== LANG TOGGLE RE-RENDER ======
  // Listen for lang changes and re-render current step
  var langToggle = document.getElementById('lang-toggle');
  if (langToggle) {
    langToggle.addEventListener('click', function() {
      setTimeout(renderStep, 50); // wait for toggles.js to swap lang
    });
  }

  // ====== INIT ======
  renderStep();
})();
</script>
</Layout>
