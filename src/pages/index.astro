---
import Layout from '../layouts/Layout.astro';

// Hotel schema — rich structured data for the home page.
// Aggregate rating (9.4 / 206 reviews) sourced from Booking.com public JSON-LD.
const hotelSchema = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: 'LITERATIUM',
  description: 'Boutique hotel in Mompox where books, coffee and the Magdalena River set the rhythm of the days. UNESCO World Heritage town, founded 1537.',
  url: 'https://literatium-web.vercel.app/',
  image: 'https://literatium-web.vercel.app/assets/literatium-logo-icon.jpeg',
  telephone: '+57 315 538 2112',
  email: 'literatium@gmail.com',
  priceRange: '$$',
  starRating: { '@type': 'Rating', ratingValue: '5' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle 21 #2-47',
    addressLocality: 'Santa Cruz de Mompox',
    addressRegion: 'Bolivar',
    addressCountry: 'CO'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 9.2419, longitude: -74.4236 },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '9.4',
    bestRating: '10',
    ratingCount: '206'
  },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'WiFi', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Garden', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Bar', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Hot tub', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Library', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Breakfast', value: true }
  ]
};
---
<Layout
  showCover={true}
  title="Literatium — La Casa de las Historias · Mompox"
  description="Hotel boutique en Mompox, donde la literatura, el cafe y el rio Magdalena se confunden con el sueno. Libros & Cafe · UNESCO 1995."
  titleEn="Literatium — The House of Stories · Mompox"
  descriptionEn="A boutique hotel in Mompox, where literature, coffee and the Magdalena River blend with dream. Books & Coffee · UNESCO 1995."
  ogImage="/assets/literatium-logo-icon.jpeg"
  jsonLd={hotelSchema}
>
<section id="frontispiece">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-bloom" aria-hidden="true"></div>
  <div class="hero-polaroid p1"><img src="/assets/space-fachada-noche.webp" alt="Literatium de noche" data-en-alt="Literatium at night" decoding="async" loading="eager"><div class="cap" data-en="Literatium at night">Literatium de noche</div></div>
  <div class="hero-polaroid p2"><img src="/assets/mompox-river-sunset-real.jpg" alt="Atardecer sobre el Río Magdalena" data-en-alt="Sunset over the Río Magdalena" decoding="async" loading="eager"><div class="cap" data-en="the Río Magdalena at dusk">el Río Magdalena al ocaso</div></div>
  <div class="hero-polaroid p3"><img src="/assets/hotel-patio-evening.jpg" alt="Calle principal de Mompox" data-en-alt="Mompox main street" decoding="async" loading="eager"><div class="cap" data-en="Mompox main street">calle principal de Mompox</div></div>
  <div class="hero-polaroid p4"><img src="/assets/real-reading-nook.jpg" alt="Rincón de lectura" data-en-alt="The reading nook" decoding="async" loading="eager"><div class="cap" data-en="the reading nook">el rincón de lectura</div></div>
  <div class="hero-content">
    <div class="hero-eyebrow" data-en="Boutique Hotel · Books &amp; Coffee · Mompox · UNESCO 1995">Hotel Boutique · Libros &amp; Café · Mompox · UNESCO 1995</div>
    <h1 class="hero-script-title"><span class="word" data-en="The">La</span> <span class="word" data-en="House">Casa</span></h1>
    <div class="hero-subtitle" data-en="of Stories">de las Historias</div>
    <p class="hero-hand" data-en="— where time stops between the pages">— donde el tiempo se detiene entre las páginas</p>
    <p class="hero-body drop-cap" data-en="There are places one remembers before knowing them. Literatium is one of them: a colonial house in Mompox, on the banks of the Río Magdalena, where books, coffee and the river set the rhythm of the days. Every corner tells a story. Every morning, a unique coffee from our farm in Huila. Every sunset, the Río Magdalena turning to gold on the water.">Hay lugares que se recuerdan antes de conocerlos. Literatium es uno de ellos: una casa colonial en Mompox, a orillas del Río Magdalena, donde los libros, el café y el río marcan el ritmo de los días. Cada rincón cuenta una historia. Cada mañana, un café único de nuestra finca en Huila. Cada atardecer, el Río Magdalena volviéndose oro sobre el agua.</p>
    <div class="hero-cta">
      <a href="https://wa.me/573155382112" target="_blank" rel="noopener" class="btn-primary" data-en="Book on WhatsApp">Reservar por WhatsApp</a>
      <a href="#casa" class="btn-ghost" data-en="Discover the house ↓">Descubre la casa ↓</a>
      <a href="/faq" class="btn-ghost" data-en="Frequently asked questions">Preguntas frecuentes</a>
    </div>
    <div class="hero-rating"><span class="score">9.5</span><span>/ 10</span><span class="sep"></span><span data-en="151+ reviews">151+ reseñas</span><span class="sep"></span><span class="score">★★★★★</span></div>
    <div class="hero-trust-signals" aria-label="Trust signals">
      <span data-en="UNESCO Heritage 1995">Patrimonio UNESCO 1995</span>
      <span class="ts-sep" aria-hidden="true">·</span>
      <span data-en="Boutique hotel · 6 rooms">Hotel boutique · 6 habitaciones</span>
      <span class="ts-sep" aria-hidden="true">·</span>
      <span data-en="Unique coffee from Huila">Café único de Huila</span>
    </div>
  </div>
  <div class="hero-curl" id="hero-curl" role="button" tabindex="0" aria-label="Turn the page">
    <svg viewBox="0 0 120 120"><path d="M 120 0 L 120 120 L 0 120 Z" fill="#8B6520" opacity="0.85"/><path d="M 120 0 L 120 120 L 22 120 Q 45 100 65 80 Q 85 60 102 35 Q 112 18 120 0 Z" fill="#0F2419" opacity="0.92"/><path d="M 22 120 Q 45 100 65 80 Q 85 60 102 35 Q 112 18 120 0" stroke="#DDB95E" stroke-width="1.2" fill="none" opacity="0.8"/></svg>
    <span class="hero-curl-label" data-en="turn the page">pasa la página</span>
  </div>
</section>

<!-- COMPACT TESTIMONIAL STRIP — transitional, no folio number -->
<section id="cartas-preview" class="bg-parchment">
  <div class="cartas-preview-eyebrow" data-en="Letters from those who have stayed">Cartas de quienes se han quedado</div>
  <p class="cartas-preview-title" data-en="A few words, written by hand, from our guests">Algunas palabras, escritas a mano, por quienes han estado aquí</p>
  <div class="cartas-preview-grid">
    <article class="cartas-preview-card">
      <div class="quote-mark">"</div>
      <p class="quote" data-en="The hotel is beautiful, the spectacular peace, the impeccable attention. Without a doubt we will return.">El hotel hermoso, la tranquilidad espectacular. La atención inmejorable. Sin duda regresaremos.</p>
      <div class="sign" data-en="— Booking.com guest">— Booking.com guest</div>
      <div class="meta" data-en="Verified review · Booking.com">Reseña verificada · Booking.com</div>
    </article>
    <article class="cartas-preview-card">
      <div class="quote-mark">"</div>
      <p class="quote" data-en="An exceptional experience — easily one of the highlights of our trip. Beautiful, peaceful, aligned with the historic charm of Mompox.">Una experiencia excepcional — fácilmente uno de los momentos destacados de nuestro viaje. Hermoso, tranquilo, alineado con el encanto histórico de Mompox.</p>
      <div class="sign" data-en="— Hotels.com guest">— Hotels.com guest</div>
      <div class="meta" data-en="Verified review · Hotels.com">Reseña verificada · Hotels.com</div>
    </article>
    <article class="cartas-preview-card">
      <div class="quote-mark">"</div>
      <p class="quote" data-en="Absolutely everything was beautiful. The human quality of Marta and all the staff made us feel at home.">Absolutamente todo fue muy hermoso. La calidad humana de Marta y de todos los trabajadores nos hicieron sentir como en casa.</p>
      <div class="sign" data-en="— Booking.com guest">— Booking.com guest</div>
      <div class="meta" data-en="Verified review · Booking.com">Reseña verificada · Booking.com</div>
    </article>
  </div>
  <a href="#cartas" class="cartas-preview-link" data-en="Read all letters →">Leer todas las cartas →</a>
</section>

<!-- FOLIO II — LA CASA -->
<section id="casa" class="folio bg-parchment">
  <!-- Warm atmospheric overlay — sits above bg-parchment texture, below content -->
  <div style="position:absolute; inset:0; background: radial-gradient(ellipse 90% 70% at 50% 20%, rgba(184,134,47,0.15), transparent 60%), radial-gradient(ellipse 70% 50% at 80% 80%, rgba(114,47,55,0.08), transparent 60%); pointer-events: none; z-index: 1;"></div>
  <div class="folio-border"></div>
  <div class="folio-corner tl"><svg viewBox="0 0 28 28"><path d="M 0 14 Q 0 0, 14 0" fill="none" stroke="#C9A04E" stroke-width="1.5"/><circle cx="0" cy="0" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner tr"><svg viewBox="0 0 28 28"><path d="M 28 14 Q 28 0, 14 0" fill="none" stroke="#C9A04E" stroke-width="1.5"/><circle cx="28" cy="0" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner bl"><svg viewBox="0 0 28 28"><path d="M 0 14 Q 0 28, 14 28" fill="none" stroke="#C9A04E" stroke-width="1.5"/><circle cx="0" cy="28" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner br"><svg viewBox="0 0 28 28"><path d="M 28 14 Q 28 28, 14 28" fill="none" stroke="#C9A04E" stroke-width="1.5"/><circle cx="28" cy="28" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-number" data-en="Folio I · The House">Folio I · La Casa</div>
  <div class="page-curl" data-next="rooms" role="button" tabindex="0"><svg viewBox="0 0 90 90"><path d="M 90 0 L 90 90 L 0 90 Z" fill="#8B6520" opacity="0.85"/><path d="M 90 0 L 90 90 L 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0 Z" fill="#FCF8EE"/><path d="M 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0" stroke="#C9A04E" stroke-width="1" fill="none" opacity="0.7"/></svg><span class="page-curl-label" data-en="turn →">turn →</span></div>
  <div class="folio-inner">
    <div class="reveal"><div class="eyebrow" data-en="Chapter One">Capítulo Primero</div><h2 class="chapter-title" data-en="A refuge where every page <em>is a morning</em>">Un refugio donde cada página <em>es una mañana</em></h2><p class="chapter-hand" data-en="The House of Stories">La Casa de las Historias</p><div class="fleuron">✦ ❦ ✦</div></div>
    <div class="casa-grid">
      <div class="body-text reveal">
        <p class="drop-cap" data-en="Literatium was born from a love of three things: books, coffee and Mompox. Felipe Cadena, founder and man of the sea — officer in the Colombian Navy — dreamed of a place where the calm of the Magdalena River met the world of letters. He found it in a colonial house near the river, and little by little that house filled with stories. Thus was born The House of Stories.">Literatium nació del amor por tres cosas: los libros, el café y Mompox. Felipe Cadena, fundador y hombre de mar — oficial de la Armada Colombiana — soñaba con un lugar donde la calma del río Magdalena se encontrara con el mundo de las letras. Lo encontró en una casa colonial cerca del río, y poco a poco esa casa se fue llenando de historias. Así nació La Casa de las Historias.</p>
        <p data-en="The colonial house was transformed slowly. Every room has books; every corner invites you to read. The garden became a retreat. The library, a meeting point. And the coffee — a unique coffee from the family farm in Huila — became the soul of the house, the first word of every morning.">La casa colonial se transformó despacio. Cada habitación tiene libros; cada rincón invita a leer. El jardín se volvió refugio. La biblioteca, punto de encuentro. Y el café — un café único de la finca familiar en Huila — se convirtió en el alma de la casa, en la primera palabra de cada mañana.</p>
        <p><em>Estamos un poco apartados del centro histórico — y eso es exactamente lo que nos hace especiales. Aquí no llega el ruido del pueblo. Llega el canto de los pájaros, el aroma del café, y de vez en cuando, el rumor de una página que se vuelve en el jardín. Una pausa, a minutos de todo.</em></p>
        <div class="marginalia" data-en="— here, mornings are counted by cups of coffee —">— aquí, las mañanas se cuentan por tazas de café —</div>
      </div>
      <div class="casa-stats reveal delay-1">
        <div class="stat-card"><div class="value">9.5</div><div class="label" data-en="Score · 151+ reviews">Puntuación · 151+ reseñas</div></div>
        <div class="stat-card"><div class="value">★</div><div class="label" data-en="Unique coffee · Family farm in Huila">Café único · Finca en Huila</div></div>
        <div class="stat-card"><div class="value">✦</div><div class="label" data-en="Books in every corner">Libros en cada rincón</div></div>
        <div class="stat-card"><div class="value">5′</div><div class="label" data-en="Minutes from the historic centre">Minutos del centro histórico</div></div>
      </div>
    </div>
    <div class="spaces-mosaic reveal">
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE I">PLATE I</div><img src="/assets/real-lobby-arches.webp" alt="Arcos coloniales de hierro forjado" data-en-alt="Colonial arches of wrought iron" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="Whispering arches">Arcos que susurran</h4><p data-en="The first step — calm welcomes you among iron and wood.">El primer paso — la calma te recibe entre hierro y madera.</p></figcaption></figure>
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE II">PLATE II</div><img src="/assets/space-moody-entrance.webp" alt="Lámpara colgante iluminando la entrada" data-en-alt="Hanging lamp lighting the entrance" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="Suspended light">Luz suspendida</h4><p data-en="The lamp hangs still over the silence of the afternoon.">La lámpara cuelga quieta sobre el silencio de la tarde.</p></figcaption></figure>
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE III">PLATE III</div><img src="/assets/space-recepcion.webp" alt="Butacas de mimbre junto a una pared de libros" data-en-alt="Wicker armchairs beside a wall of books" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="Wicker and books">Mimbre y libros</h4><p data-en="Armchairs that invite you to stay — a whole wall of stories waiting to be read.">Butacas que invitan a quedarse — toda una pared de historias que esperan ser leídas.</p></figcaption></figure>
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE IV">PLATE IV</div><img src="/assets/space-corredor.webp" alt="Corredor cubierto con helechos colgantes" data-en-alt="Covered corridor with hanging ferns" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="Ferns and brick">Helechos y ladrillo</h4><p data-en="Ferns hanging from the ceiling, swaying with the river breeze.">Helechos que cuelgan del techo y se mecen con la brisa del río.</p></figcaption></figure>
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE V">PLATE V</div><img src="/assets/guest-chillin.webp" alt="Huésped leyendo en un rincón" data-en-alt="Guest reading in a corner" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="The corner of rest">El rincón del descanso</h4><p data-en="The corner where one sits with a book and forgets the time.">El rincón donde uno se sienta con un libro y olvida la hora.</p></figcaption></figure>
      <figure class="space-plate"><div class="space-plate-num" data-en="PLATE VI">PLATE VI</div><img src="/assets/space-zona-verde.webp" alt="Jardín tropical con faroles" data-en-alt="Tropical garden with lanterns" loading="lazy" decoding="async"><figcaption class="space-caption"><h4 data-en="The secret garden">El jardín secreto</h4><p data-en="Tropical and hushed — at dusk, the crickets are the only conversation.">Tropical y callado — al anochecer, los grillos son la única conversación.</p></figcaption></figure>
    </div>
    <article class="martica-card reveal">
      <div class="martica-card-img" role="img" aria-label="Retrato de Martica"></div>
      <div class="martica-card-body" style="position: relative;">
        <!-- Macondo magic: yellow butterflies drifting -->
        <div aria-hidden="true" style="position:absolute; top:-20px; right:10px; width:30px; height:25px; opacity:0.7; animation: drift-mote 12s ease-in-out infinite; z-index:5;">
          <svg viewBox="0 0 50 42"><g style="transform-origin: right center; animation: flap-l 0.18s ease-in-out infinite alternate;"><path d="M 25 21 Q 7 3 1 13 Q -1 23 7 25 Q 18 26 25 21 Z" fill="#F5D547" opacity="0.85"/></g><g style="transform-origin: left center; animation: flap-r 0.18s ease-in-out infinite alternate;"><path d="M 25 21 Q 43 3 49 13 Q 51 23 43 25 Q 32 26 25 21 Z" fill="#F5D547" opacity="0.85"/></g><ellipse cx="25" cy="21" rx="1.5" ry="9" fill="#3D2817"/></svg>
        </div>
        <div aria-hidden="true" style="position:absolute; top:40px; right:40px; width:20px; height:17px; opacity:0.5; animation: drift-mote 15s ease-in-out 3s infinite; z-index:5;">
          <svg viewBox="0 0 50 42"><g style="transform-origin: right center; animation: flap-l 0.18s ease-in-out infinite alternate;"><path d="M 25 21 Q 7 3 1 13 Q -1 23 7 25 Q 18 26 25 21 Z" fill="#F5D547" opacity="0.7"/></g><g style="transform-origin: left center; animation: flap-r 0.18s ease-in-out infinite alternate;"><path d="M 25 21 Q 43 3 49 13 Q 51 23 43 25 Q 32 26 25 21 Z" fill="#F5D547" opacity="0.7"/></g><ellipse cx="25" cy="21" rx="1.5" ry="9" fill="#3D2817"/></svg>
        </div>
        <!-- Warm Macondo glow -->
        <div aria-hidden="true" style="position:absolute; inset:0; background: radial-gradient(ellipse 60% 50% at 30% 30%, rgba(245,213,71,0.12), transparent 70%); pointer-events: none; z-index: 1;"></div><div class="quote-mark">"</div><p class="tagline" data-en="The momposina who makes everything happen — and makes everyone return.">La momposina que hace que todo pase — y que todos vuelvan.</p><h3 data-en='Marta — "Martica"'>Marta — "Martica"</h3><div class="role" data-en="Manager · The star of Literatium">Gerente · La estrella de Literatium</div><p class="bio" data-en="Martica is the soul of Literatium, that invisible force that makes things happen without anyone seeing them happen. Momposina by birth, she knows the town as only someone who grew up among its streets can know it — every church, every boatman, every recipe passed down by word of mouth. She welcomes guests as one welcomes a friend arriving from afar: with coffee, with a hand-drawn map, and with the certainty that here, for a few nights, the world will be all right.">Martica es el alma de Literatium, esa fuerza invisible que hace que las cosas sucedan sin que nadie las vea suceder. Momposina de nacimiento, conoce el pueblo como solo quien ha crecido entre sus calles puede conocerlo — cada iglesia, cada boga, cada receta que se transmite de boca en boca. Recibe a los huéspedes como se recibe a un amigo que llega de lejos: con café, con un mapa dibujado a mano, y con la certeza de que aquí, por unas noches, el mundo va a estar bien.</p></div>
    </article>
  </div>
</section>

<!-- FOLIO III — CAFÉ -->
<section id="rooms" class="folio on-dark">
  <div class="folio-border" style="border-color: var(--brass); outline-color: var(--brass-dark); opacity: 0.3;"></div>
  <div class="folio-corner tl"><svg viewBox="0 0 28 28"><path d="M 0 14 Q 0 0, 14 0" fill="none" stroke="#DDB95E" stroke-width="1.5"/><circle cx="0" cy="0" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner tr"><svg viewBox="0 0 28 28"><path d="M 28 14 Q 28 0, 14 0" fill="none" stroke="#DDB95E" stroke-width="1.5"/><circle cx="28" cy="0" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner bl"><svg viewBox="0 0 28 28"><path d="M 0 14 Q 0 28, 14 28" fill="none" stroke="#DDB95E" stroke-width="1.5"/><circle cx="0" cy="28" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-corner br"><svg viewBox="0 0 28 28"><path d="M 28 14 Q 28 28, 14 28" fill="none" stroke="#DDB95E" stroke-width="1.5"/><circle cx="28" cy="28" r="2" fill="#DDB95E"/></svg></div>
  <div class="folio-number" style="color: var(--brass-light);" data-en="Folio II · Rooms">Folio II · Habitaciones</div>
  <div class="page-curl" data-next="cafe" role="button" tabindex="0"><svg viewBox="0 0 90 90"><path d="M 90 0 L 90 90 L 0 90 Z" fill="#DDB95E" opacity="0.85"/><path d="M 90 0 L 90 90 L 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0 Z" fill="#0F2419"/><path d="M 18 90 Q 35 75 50 60 Q 65 45 78 25 Q 84 12 90 0" stroke="#DDB95E" stroke-width="1" fill="none" opacity="0.7"/></svg><span class="page-curl-label" data-en="turn →">turn →</span></div>
  <div class="folio-inner">
    <div class="reveal"><div class="eyebrow" style="color: var(--brass-light);" data-en="Chapter Two">Capítulo Segundo</div><h2 class="chapter-title on-dark" data-en="Five chapters <em>to choose from</em>">Cinco capítulos <em>para elegir</em></h2><p class="rooms-intro" data-en="Every room has its own character, its books, its light. All with air conditioning, private bathroom, TV, coffee maker and the silence found only far from the centre.">Cada habitación tiene su propio carácter, sus libros, su luz. Todas con aire acondicionado, baño privado, TV, cafetera y el silencio que solo se encuentra lejos del centro.</p><div class="fleuron" style="color: var(--brass-light);">✦ ❦ ✦</div></div>
    <div class="rooms-row reveal delay-1">
      <article class="room-card featured"><img class="room-card-img" src="/assets/room-suite-9.webp" alt="Suite con jardín y bañera" data-en-alt="Suite with garden and tub" loading="lazy" decoding="async"><div class="room-card-body"><div class="room-card-num" data-en="ROOM V">HABITACIÓN V</div><h3 data-en="Suite with Garden and Tub">Suite con Jardín y Bañera</h3><div class="room-card-specs"><span data-en="1 king + sofa bed">1 king + sofá cama</span><span>428 sq ft</span><span data-en="Garden">Jardín</span></div></div></article>
      <article class="room-card"><img class="room-card-img" src="/assets/room-deluxe-3.webp" alt="Deluxe Suite" data-en-alt="Deluxe Suite" loading="lazy" decoding="async"><div class="room-card-body"><div class="room-card-num" data-en="ROOM IV">HABITACIÓN IV</div><h3 data-en="Deluxe Suite">Deluxe Suite</h3><div class="room-card-specs"><span data-en="1 king + sofa bed">1 king + sofá cama</span><span>410 sq ft</span><span data-en="Garden">Jardín</span></div></div></article>
      <article class="room-card"><img class="room-card-img" src="/assets/room-king-7.webp" alt="King Room" data-en-alt="King Room" loading="lazy" decoding="async"><div class="room-card-body"><div class="room-card-num" data-en="ROOM I">HABITACIÓN I</div><h3 data-en="King Room">King Room</h3><div class="room-card-specs"><span data-en="1 king">1 king</span><span>290 sq ft</span><span data-en="City">Ciudad</span></div></div></article>
