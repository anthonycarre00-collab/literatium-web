---
import Layout from '../../../layouts/Layout.astro';
import Folio from '../../../components/Folio.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import JournalCard from '../../../components/JournalCard.astro';
import {
  getAllTags,
  getArticlesByTag,
  slugifyTag
} from '../../../data/journal-articles';
import type { JournalArticle } from '../../../data/journal-articles';

export function getStaticPaths() {
  const tags = getAllTags();
  return tags.map((t) => ({
    params: { tag: slugifyTag(t) },
    props: { tagLabel: t }
  }));
}

interface Props { tag: string; tagLabel: string; }
const { tag: tagSlug, tagLabel } = Astro.props as Props;
const articles: JournalArticle[] = getArticlesByTag(tagLabel);
---
<Layout
  title={`Etiqueta: ${tagLabel} — Diario · Literatium`}
  description={`Artículos del diario de Literatium etiquetados con «${tagLabel}».`}
>
<Folio id="diario-etiqueta" folioNumber="Folio XI · Diario" folioNumberEn="Folio XI · Journal" dark={true}>
  <Breadcrumbs items={[
    { label: 'Literatium', href: '/' },
    { label: 'Diario', href: '/diario' },
    { label: `Etiqueta: ${tagLabel}` }
  ]} />

  <div class="reveal">
    <div class="eyebrow" style="color: var(--brass-light);" data-en="Tag">Etiqueta</div>
    <h1 class="chapter-title on-dark">{tagLabel}</h1>
    <div class="fleuron" style="color: var(--brass-light);">✦ ❦ ✦</div>
  </div>

  <div class="reveal delay-1">
    <p class="journal-intro" data-en={`${articles.length} ${articles.length === 1 ? 'article' : 'articles'} tagged with this word.`}>{articles.length === 1 ? `${articles.length} artículo con esta etiqueta.` : `${articles.length} artículos con esta etiqueta.`}</p>
    <div class="journal-archive-count" data-en={`${articles.length} ${articles.length === 1 ? 'article' : 'articles'}`}>{articles.length} {articles.length === 1 ? 'artículo' : 'artículos'}</div>
  </div>

  <div class="journal-grid reveal delay-2">
    {articles.map((article) => (
      <JournalCard article={article} />
    ))}
  </div>

  <div class="reveal delay-2" style="margin-top: 70px; text-align: center;">
    <a href="/diario" class="nav-cta" style="display: inline-block; padding: 12px 28px; font-family: var(--font-caps); font-size: 0.62rem; letter-spacing: 0.22em; color: var(--brass-light); border: 1px solid var(--brass); background: transparent; text-decoration: none; border-radius: 2px;" data-en="← All articles">← Todos los artículos</a>
  </div>
</Folio>
</Layout>
