---
import Layout from '../layouts/Layout.astro';
import Folio from '../components/Folio.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

// Five Mompox subsections — each links to a real /mompox/<slug> page
const subsections = [
  {
    slug: 'guias',
    icon: '🗺️',
    title: 'Guías',
    titleEn: 'Guides',
    desc: 'Recorre Mompox a pie: albarrada, seis iglesias coloniales, plazas y portales. Historia viva desde 1537.',
    descEn: 'Walk Mompox: albarrada, six colonial churches, plazas and porticos. Living history since 1537.',
    img: '/assets/mompox-colonial-street.jpg'
  },
  {
    slug: 'sabores',
    icon: '🍽️',
    title: 'Sabores',
    titleEn: 'Flavours',
    desc: 'Bocachico del Magdalena, casabito, queso de capa, corozo, arepa \'e huevo. El sabor del Caribe fluvial.',
    descEn: 'Bocachico from the Magdalena, casabito, queso de capa, corozo, egg arepa. The taste of the riverine Caribbean.',
    img: '/assets/momposina-food.png'
  },
  {
    slug: 'palabras',
    icon: '📖',
    title: 'Palabras',
    titleEn: 'Words',
    desc: 'Albarrada, champán, boga, filigrana, Macondo. Doce palabras para leer Mompox en su propio léxico.',
    descEn: 'Albarrada, champán, boga, filigree, Macondo. Twelve words to read Mompox in its own lexicon.',
    img: '/assets/mural-art.jpg'
  },
  {
    slug: 'mapas',
    icon: '🧭',
    title: 'Mapas',
    titleEn: 'Maps',
    desc: 'El mapa del río — cómo llegar por aire, tierra o agua. El puente Roncador, el terminal fluvial, el centro.',
    descEn: 'The river map — how to arrive by air, land or water. The Roncador bridge, the river terminal, the centre.',
    img: '/assets/mompox-drone.jpg'
  },
  {
    slug: 'juegos',
    icon: '🎲',
    title: 'Juegos',
    titleEn: 'Games',
    desc: 'Parqués momposino, canastas, capa, boliche. Los juegos del portal donde el tiempo se vuelve lento.',
    descEn: 'Momposino parqués, canastas, capa, bowls. The porch games where time turns slow.',
    img: '/assets/rocking-chair-porch.png'
  },
];
---
<Layout title="Mompox — Literatium" description="Descubre Mompox — el pueblo que inspiró a García Márquez. Patrimonio UNESCO, fundado 1537. Guías, sabores, palabras, mapas y juegos.">
<Folio id="mompox-hub" folioNumber="Folio V · Mompox" folioNumberEn="Folio V · Mompox" dark={true}>
  <Breadcrumbs items={[{ label: 'Literatium', href: '/' }, { label: 'Mompox' }]} />
  <div class="reveal">
    <div class="eyebrow" style="color: var(--brass-light);" data-en="Chapter Four · Mompox">Capítulo Cuarto · Mompox</div>
    <h1 class="chapter-title on-dark">El pueblo donde <em>el tiempo se detiene</em></h1>
    <div class="fleuron" style="color: var(--brass-light);">✦ ❦ ✦</div>
  </div>

  <div class="reveal delay-1" style="max-width: 640px; margin: 30px auto;">
    <p style="font-family: var(--font-body); color: var(--parchment); opacity: 0.9; font-size: 1.05rem; line-height: 1.8; text-align: center;" data-en="A UNESCO World Heritage Site since 1995, Mompox is a town that inspired García Márquez and that still today seems stopped in another century. The cobblestone streets, colonial churches and the slow river give it an atmosphere found nowhere else in the Colombian Caribbean. Below: five chapters to read Mompox in its own vocabulary.">Patrimonio de la Humanidad por la UNESCO desde 1995, Mompox es un pueblo que inspiró a García Márquez y que aún hoy parece detenido en otro siglo. Las calles empedradas, las iglesias coloniales y el río lento le dan una atmósfera que no se encuentra en ningún otro lugar del Caribe colombiano. Abajo: cinco capítulos para leer Mompox en su propio vocabulario.</p>
  </div>

  <div class="reveal delay-1" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 50px; max-width: 1100px; margin-left: auto; margin-right: auto;">
    {subsections.map((s) => (
      <a href={`/mompox/${s.slug}`} class="mompox-card" style="text-decoration: none; color: inherit;">
        <div class="mompox-card-img" style="background-image: url('{s.img}');"></div>
        <div class="mompox-card-body">
          <div style="font-size: 1.8rem; margin-bottom: 8px;">{s.icon}</div>
          <h3 style="font-family: var(--font-display); font-style: italic; font-size: 1.4rem; color: var(--brass-light); margin-bottom: 10px;" data-en={s.titleEn}>{s.title}</h3>
          <p style="font-family: var(--font-body); font-size: 0.92rem; color: var(--parchment); opacity: 0.82; line-height: 1.6;" data-en={s.descEn}>{s.desc}</p>
          <span class="mompox-card-cta" data-en="Read this chapter →">Leer este capítulo →</span>
        </div>
      </a>
    ))}
  </div>

  <div class="reveal delay-2" style="margin-top: 70px; display: flex; justify-content: center;">
    <div class="marginalia" style="max-width: 560px; color: var(--brass-light); background: rgba(15,36,25,0.5);" data-en="— In Mompox there are no bad seasons — only different forms of heat and calm. —">— En Mompox no hay estaciones malas — solo distintas formas de calor y de calma. —</div>
  </div>

  <div class="reveal delay-2" style="margin-top: 60px; text-align: center;">
    <a href="/book" class="nav-cta" style="display: inline-block; padding: 14px 32px; font-family: var(--font-caps); font-size: 0.7rem; letter-spacing: 0.25em; color: var(--forest-dark); background: var(--brass); text-decoration: none; border-radius: 2px; transition: background 0.3s ease;" data-en="Plan your visit →">Planifica tu visita →</a>
  </div>
</Folio>

<style is:global>
  .mompox-card {
    display: block;
    background: rgba(247,240,220,0.04);
    border: 1px solid rgba(221,185,94,0.3);
    overflow: hidden;
    transition: transform 0.4s ease, border-color 0.4s ease, background 0.4s ease;
  }
  .mompox-card:hover {
    transform: translateY(-4px);
    border-color: var(--brass);
    background: rgba(247,240,220,0.08);
  }
  .mompox-card-img {
    width: 100%;
    height: 180px;
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid rgba(221,185,94,0.3);
    filter: saturate(0.85) brightness(0.85);
    transition: filter 0.4s ease;
  }
  .mompox-card:hover .mompox-card-img { filter: saturate(1) brightness(1); }
  .mompox-card-body { padding: 24px; }
  .mompox-card-cta {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-caps);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--brass-light);
    border-bottom: 1px solid rgba(221,185,94,0.4);
    padding-bottom: 4px;
  }
</style>
</Layout>
