---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="404 — Folio perdido · Literatium"
  description="Este folio no existe. La página que buscas se perdió entre los libros."
  titleEn="404 — Missing folio · Literatium"
  descriptionEn="This folio is missing. The page you are looking for got lost among the books."
>
<div style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 6rem 2rem; text-align: center;">
  <div style="font-family: var(--font-display); font-size: 8rem; color: var(--brass); opacity: 0.3; line-height: 1;">404</div>
  <h1 style="font-family: var(--font-display); font-style: italic; font-size: 2.5rem; color: var(--parchment); margin: 20px 0;" data-en="This folio is missing.">Este folio no existe.</h1>
  <p style="font-family: var(--font-body); font-size: 1.1rem; color: var(--parchment); opacity: 0.7; max-width: 400px; line-height: 1.7; margin-bottom: 30px;" data-en="The page you're looking for got lost among the books. Perhaps it was borrowed by another guest.">La página que buscas se perdió entre los libros. Quizá otro huésped la tomó prestada.</p>
  <a href="/" class="btn-primary" data-en="← Return to the book">← Volver al libro</a>
</div>
</Layout>
